rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chỉ cho phép sinh viên tải lên và đọc tệp trong thư mục thuộc UID của chính họ
    match /users/{userId}/documents/{documentId}/{fileName} {
      // Chỉ đọc hoặc xóa khi đúng chủ sở hữu
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      
      // Tải lên tệp: bắt buộc đúng UID và dung lượng tệp không được vượt quá 25MB (26,214,400 bytes)
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size <= 25 * 1024 * 1024;
    }
  }
}
